rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{sessionId} {

      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly([
          'hostId', 'status', 'createdAt',
          'players', 'currentPlayerIndex',
          'rolls', 'turnStartedAt', 'heartbeats', 'turnTimeout'
        ]) &&
        request.resource.data.hostId is string &&
        request.resource.data.hostId.size() > 0 &&
        request.resource.data.hostId.size() <= 100 &&
        request.resource.data.status == 'lobby' &&
        request.resource.data.createdAt is number &&
        request.resource.data.players is list &&
        request.resource.data.players.size() >= 1 &&
        request.resource.data.players.size() <= 20 &&
        request.resource.data.currentPlayerIndex == 0 &&
        request.resource.data.rolls is list &&
        request.resource.data.rolls.size() == 0 &&
        request.resource.data.turnStartedAt is number &&
        request.resource.data.heartbeats is map;

      allow update: if
        request.resource.data.hostId == resource.data.hostId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status in ['lobby', 'playing'] &&
        request.resource.data.players is list &&
        request.resource.data.players.size() <= 20 &&
        request.resource.data.rolls is list &&
        request.resource.data.rolls.size() <= 5000;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
